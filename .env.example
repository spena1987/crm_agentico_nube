# Google Gemini API Key
# Obtenla desde Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Conexión directa a base de datos Supabase (PostgreSQL) para daemon o backend
DATABASE_URL=https://ppbgmkxxpeuiutvuynaw.supabase.co

# Supabase URL y llaves de acceso
SUPABASE_URL=https://tu_proyecto_supabase_id.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta_aqui

# Next.js Variables de Entorno Públicas (Debe replicar las de arriba)
# Requerido por el frontend en Next.js para poder inicializar el cliente en el navegador
NEXT_PUBLIC_SUPABASE_URL=https://tu_proyecto_supabase_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_public_key_aqui

# Puerto de ejecución del backend
PORT=8000
