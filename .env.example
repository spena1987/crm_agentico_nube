# ====================================================================
# CONFIGURACIÓN GENERAL (CRM MÉDICO + BOT AGÉNTICO EN NUBE)
# ====================================================================

# 1. Google Gemini API (Agente con Function Calling & Multimodal)
# Obtener en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# 2. Supabase (Base de Datos PostgreSQL & Realtime & Storage)
# Obtener en https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
SUPABASE_URL=https://tu_proyecto_supabase_id.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta_aqui
SUPABASE_JWT_SECRET=tu_supabase_jwt_secret_para_validar_tokens
DATABASE_URL=postgresql://postgres.tu_id:tu_password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# 3. Frontend Next.js (Variables Públicas para Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://tu_proyecto_supabase_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_public_key_aqui
# En producción (Vercel), apunta a la URL pública generada por Railway (ej: https://tu-backend.up.railway.app)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 4. Pasarela de WhatsApp (Evolution API v2 en Railway - Legacy)
EVOLUTION_API_URL=https://tu-evolution-api.up.railway.app
EVOLUTION_API_KEY=tu_token_secreto_evolution_2026
EVOLUTION_INSTANCE_NAME=medcrm
CRM_BACKEND_PUBLIC_URL=https://tu-backend.up.railway.app/api/whatsapp/webhook/incoming

# 4.1 Meta WhatsApp Cloud API (Graph API v21+ Oficial)
META_WA_PHONE_NUMBER_ID=100012345678901
META_WA_WABA_ID=100098765432100
META_WA_ACCESS_TOKEN=EAAG...tu_system_user_access_token_permanente
META_WA_APP_SECRET=tu_meta_app_secret_para_validar_firma_hmac
META_WA_VERIFY_TOKEN=medcrm_meta_verify_token_2026
REDIS_URL=redis://default:tu_password@redis.railway.internal:6379/0

# 5. Integración Opcional: API Geclisa (Lectura de Turnos / Pacientes / LIO)
GECLISA_API_BASE_URL=https://creogeclisa.fertilidadmendoza.com.ar:98
GECLISA_USERNAME=tu_usuario_geclisa
GECLISA_PASSWORD=tu_contrasenia_geclisa

# 6. Configuración de Servidor Backend & Seguridad CORS
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://tu-frontend.vercel.app
